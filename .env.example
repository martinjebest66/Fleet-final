# ============================================================
# Fleet Manager — configuration template
#
#   cp .env.example .env
#
# Never commit the resulting .env: it holds real credentials.
# ============================================================

# --- Required secrets --------------------------------------
# Signing key for session tokens. Generate a fresh one per deployment:
#   openssl rand -hex 32
# The application refuses to start in production without it, or with a known
# weak value.
JWT_SECRET=

# Initial administrator account. The password is only applied when the account
# is created (or has no password yet) — changing it later does not reset an
# existing password unless ADMIN_PASSWORD_RESET_ON_START=true.
ADMIN_EMAIL=admin@autoskola.cz
ADMIN_PASSWORD=

# --- Runtime -----------------------------------------------
# production | development. `development` relaxes the startup checks and
# enables the mock data generators.
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- Database ----------------------------------------------
# Inside docker compose this is the service name, not a public address.
MONGO_URL=mongodb://mongodb:27017
DB_NAME=fleet_manager

# --- Cookies -----------------------------------------------
# Defaults suit a same-origin deployment over plain HTTP.
# With TLS in front of the container set COOKIE_SECURE=true.
# COOKIE_SAMESITE=none additionally requires COOKIE_SECURE=true and is only
# needed when the frontend is served from a different site than the API.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# --- CORS --------------------------------------------------
# Leave empty for a same-origin deployment (the supported setup). Otherwise a
# comma-separated list of exact origins. "*" is rejected in production because
# it cannot be combined safely with cookie authentication.
CORS_ORIGINS=

# --- Frontend build ----------------------------------------
# Empty = the browser calls /api on the origin that served the page.
REACT_APP_BACKEND_URL=

# --- Ports -------------------------------------------------
# The web port is published on the loopback interface only, so the container
# is reached through a reverse proxy on the host (Caddy / Nginx / Traefik)
# which terminates TLS. Nothing is exposed on the public interface.
#
# Running WITHOUT a host reverse proxy? Then the app is unreachable from
# outside until you set HTTP_BIND=0.0.0.0 (and ideally HTTP_PORT=80).
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# Teltonika trackers connect from mobile networks, so this port must stay on a
# public interface — binding it to loopback silently stops all GPS data.
TELTONIKA_BIND=0.0.0.0
TELTONIKA_TCP_PORT=5027

# --- Teltonika GPS -----------------------------------------
TELTONIKA_ENABLED=true
# Seconds a connected tracker may stay silent before the connection is recycled.
TELTONIKA_IDLE_TIMEOUT_SEC=900

# --- Feature flags -----------------------------------------
# Mock/simulated GPS generators write into the real collections; off in
# production.
ALLOW_MOCK_DATA=false
# Reset the admin password to ADMIN_PASSWORD on every start. Off by default so
# a password changed by an operator survives a redeploy.
ADMIN_PASSWORD_RESET_ON_START=false
# Allow ICS calendar feeds on private/internal addresses (SSRF guard override).
ICS_ALLOW_PRIVATE_HOSTS=false

# --- Limits ------------------------------------------------
MAX_UPLOAD_BYTES=10485760
MAX_IMPORT_BYTES=26214400
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SEC=300

# --- Memory ------------------------------------------------
# Node heap for the React production build. Webpack needs far more than the
# default heap for this bundle; too low and the build fails with "JavaScript
# heap out of memory" or is OOM-killed (Docker reports exit code 137).
#   2 GB host -> 1536, 4 GB host -> 2048, larger builds -> 3072
NODE_MAX_OLD_SPACE_MB=2048

# Runtime ceilings for the running containers. MongoDB sizes its WiredTiger
# cache from the cgroup limit, so a limit keeps it from filling all RAM.
APP_MEM_LIMIT=1g
APP_MEM_RESERVATION=256m
MONGO_MEM_LIMIT=1g
MONGO_MEM_RESERVATION=256m

# --- Email notifications (optional) ------------------------
RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev
