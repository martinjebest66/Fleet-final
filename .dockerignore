# Build context hygiene — keep the image small and free of local state.
.git
.gitignore
.github
.emergent
.venv-audit

node_modules
frontend/node_modules
frontend/build
frontend/coverage

__pycache__
**/__pycache__
*.pyc
.pytest_cache
.mypy_cache

# Never bake secrets into an image layer.
.env
.env.*
*.env
!.env.example
frontend/.env*
backend/.env*

test_reports
tests
memory
*.log
*.md
!README.md
